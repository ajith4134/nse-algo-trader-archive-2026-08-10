[Unit]
Description=NSE Algo Trader Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/nse-algo-trader
ExecStart=/home/opc/nse-algo-trader/.venv/bin/python -m nse_algo_trader.dashboard.dashboard_server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
